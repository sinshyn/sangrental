# Use environment variables or dotnet user-secrets; never store real credentials here.
ConnectionStrings__SangRental=
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5100
# Example names only: dotnet does not automatically load this file.
# API/Admin must use the same durable root; production requires an absolute path outside all public web roots.
Media__Enabled=true
Media__RootPath=../../artifacts/media
Media__ContentFormat=webp
Media__Quality=82
Media__MaxUploadBytes=10485760
Media__MaxPixels=20000000
Media__MaxDimension=10000
